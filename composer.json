{
  "name": "milpa/template",
  "description": "Framework-agnostic template rendering (Latte) for the Milpa PHP framework.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://teamx.agency"
    }
  ],
  "require": {
    "php": ">=8.3",
    "latte/latte": ">=3.0,<3.1",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.65",
    "milpa/core": "^0.6",
    "phpstan/phpdoc-parser": "^2.3",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Template\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Template\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  }
}
